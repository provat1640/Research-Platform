APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt  # Required for Azure MySQL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional hosted sync through Supabase REST. Keep the service key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TIMEOUT=10
SUPABASE_CONNECT_TIMEOUT=3

# AI Research Configuration
# AI-generated content access: true makes AI tools free for all authenticated users
AI_FREE_FOR_ALL=true

# OpenAI-compatible AI endpoint. Defaults to local Ollama for free/private development.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2
AI_TIMEOUT=30
AI_CONNECT_TIMEOUT=5
AI_TEMPERATURE=0.2

# Recommended: Google Gemini (Free Tier: 15 RPM / 1M TPM / 1500 RPD)
# Ultra-large 1M+ token context window ideal for academic research, full thesis chapters, and citations.
# Uses Google's official OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# Groq provides an OpenAI-compatible fast research assistant endpoint.
# Keep the key server-side and set it in your local .env only.
# Free-tier models:
# - llama-3.3-70b-versatile (default, general research assistant)
# - deepseek-r1-distill-70b (reasoning and structured analysis)
# - qwen/qwen3-32b (fast text processing and code generation)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Real-time WebSocket broadcasting via Laravel Reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Required for remote MCP clients. Generate a long random bearer token.
MCP_ACCESS_TOKEN=
